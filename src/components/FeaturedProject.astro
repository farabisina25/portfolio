---
import type { Project } from "../data/projects";
import TechTag from "./ui/TechTag.astro";
import Button from "./ui/Button.astro";
import GitHubIcon from "./icons/GitHubIcon.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const embedUrl = project.videoId
  ? `https://www.youtube-nocookie.com/embed/${project.videoId}?rel=0`
  : undefined;
---

<article class="overflow-hidden rounded-2xl border border-border bg-surface-card">
  <div class="grid lg:grid-cols-2">
    {
      embedUrl && (
        <div class="flex items-center p-4 sm:p-5 lg:py-6 lg:pr-2 lg:pl-6">
          <div class="aspect-video w-full overflow-hidden rounded-xl bg-black">
            <iframe
              src={embedUrl}
              title={`${project.name} gameplay`}
              class="h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            />
          </div>
        </div>
      )
    }

    <div class="flex flex-col justify-center p-6 md:p-8">
      <p class="font-mono text-xs uppercase tracking-wider text-accent">
        Featured project
      </p>
      <div class="mt-3 flex items-start justify-between gap-4">
        <h3 class="text-2xl font-semibold tracking-tight text-text-primary">
          {project.name}
        </h3>
        {
          project.githubUrl && (
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${project.name} GitHub repository`}
              class="shrink-0 text-text-muted transition-colors hover:text-text-primary"
            >
              <GitHubIcon class="h-5 w-5" />
            </a>
          )
        }
      </div>
      <p class="mt-3 text-sm leading-relaxed text-text-secondary md:text-base">
        {project.description}
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {project.technologies.map((tech) => <TechTag label={tech} />)}
      </div>
      {
        project.caseStudyHref && (
          <div class="mt-6">
            <Button href={project.caseStudyHref}>Read the Project Details</Button>
          </div>
        )
      }
    </div>
  </div>
</article>
