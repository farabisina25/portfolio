---
const navLinks = [
  { href: "/#projects", label: "Projects" },
  { href: "/#experience", label: "Experience" },
  { href: "/#education", label: "Education" },
  { href: "/#contact", label: "Contact" },
];
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border-subtle bg-surface/80 backdrop-blur-md"
>
  <nav
    class="mx-auto flex w-full max-w-5xl items-center gap-3 px-4 py-3 sm:px-6 sm:py-4"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="shrink-0 font-mono text-sm font-medium text-text-primary transition-colors hover:text-accent"
    >
      Portfolio
    </a>

    <ul
      class="flex min-w-0 flex-1 items-center justify-start gap-1 overflow-x-auto overscroll-x-contain pe-1 [scrollbar-width:none] sm:justify-end sm:gap-2 sm:overflow-visible sm:pe-0 [&::-webkit-scrollbar]:hidden"
    >
      {
        navLinks.map((link) => (
          <li class="shrink-0">
            <a
              href={link.href}
              class="block whitespace-nowrap rounded-md px-2.5 py-2 text-sm text-text-secondary transition-colors hover:text-text-primary sm:px-3"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
