---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TechTag from "../../components/ui/TechTag.astro";
import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import { swordman } from "../../data/swordman";
import { profile } from "../../data/profile";

const embedUrl = `https://www.youtube-nocookie.com/embed/${swordman.videoId}?rel=0`;
---

<Layout
  title={`${swordman.name} | ${profile.name}`}
  description={swordman.summary}
>
  <Header />

  <main class="mx-auto max-w-5xl px-6 pt-28 pb-16">
    <a
      href="/#projects"
      class="text-sm text-text-secondary transition-colors hover:text-text-primary"
    >
      ← Back to projects
    </a>

    <p class="mt-8 font-mono text-xs uppercase tracking-wider text-accent">
      Top-down arena brawler · Unity 6
    </p>
    <div class="mt-3 flex items-start justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight text-text-primary md:text-5xl">
        {swordman.name}
      </h1>
      <a
        href={swordman.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${swordman.name} GitHub repository`}
        class="mt-2 shrink-0 text-text-muted transition-colors hover:text-text-primary"
      >
        <GitHubIcon class="h-6 w-6" />
      </a>
    </div>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-secondary md:text-lg">
      {swordman.summary}
    </p>

    <div class="mt-8 flex justify-center">
      <div class="aspect-[9/16] w-full max-w-[280px] overflow-hidden rounded-2xl border border-border bg-black sm:max-w-[320px]">
        <iframe
          src={embedUrl}
          title={`${swordman.name} gameplay`}
          class="h-full w-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Overview</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-text-secondary md:text-base">
        {swordman.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Combat</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-text-secondary md:text-base">
        {swordman.combatIntro}
      </p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          swordman.combat.map((item) => (
            <li class="rounded-xl border border-border bg-surface-card px-4 py-3">
              <p class="text-sm font-medium text-text-primary">{item.name}</p>
              <p class="mt-1 text-sm text-text-secondary">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-semibold text-text-primary">Movement & arena</h2>
        <div class="mt-4 h-px w-12 bg-accent"></div>
        <p class="mt-6 text-sm leading-relaxed text-text-secondary md:text-base">
          {swordman.movement}
        </p>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary md:text-base">
          {swordman.arena}
        </p>
      </div>
      <div>
        <h2 class="text-xl font-semibold text-text-primary">Enemies</h2>
        <div class="mt-4 h-px w-12 bg-accent"></div>
        <p class="mt-6 text-sm leading-relaxed text-text-secondary md:text-base">
          {swordman.enemies}
        </p>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Sand, feedback & tools</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-text-secondary md:text-base">
        <p>{swordman.sand}</p>
        <p>{swordman.feedback}</p>
        <p>{swordman.tools}</p>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Technologies</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 flex flex-wrap gap-2">
        {swordman.stack.map((tech) => <TechTag label={tech} />)}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Features</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          swordman.features.map((feature) => (
            <li class="rounded-xl border border-border bg-surface-card px-4 py-3 text-sm leading-relaxed text-text-secondary">
              {feature}
            </li>
          ))
        }
      </ul>
    </section>

    <Footer />
  </main>
</Layout>
