---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TechTag from "../../components/ui/TechTag.astro";
import GitHubIcon from "../../components/icons/GitHubIcon.astro";
import { wheelGamble } from "../../data/wheelGamble";
import { profile } from "../../data/profile";

const embedUrl = `https://www.youtube-nocookie.com/embed/${wheelGamble.videoId}?rel=0`;
---

<Layout
  title={`${wheelGamble.name} | ${profile.name}`}
  description={wheelGamble.summary}
>
  <Header />

  <main class="mx-auto max-w-5xl px-4 pt-28 pb-16 sm:px-6">
    <a
      href="/#projects"
      class="text-sm text-text-secondary transition-colors hover:text-text-primary"
    >
      ← Back to projects
    </a>

    <p class="mt-8 font-mono text-xs uppercase tracking-wider text-accent">
      Android wheel game · Unity 2021.3
    </p>
    <div class="mt-3 flex items-start justify-between gap-4">
      <h1 class="text-3xl font-semibold tracking-tight text-text-primary md:text-5xl">
        {wheelGamble.name}
      </h1>
      <a
        href={wheelGamble.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${wheelGamble.name} GitHub repository`}
        class="mt-2 shrink-0 text-text-muted transition-colors hover:text-text-primary"
      >
        <GitHubIcon class="h-6 w-6" />
      </a>
    </div>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-text-secondary md:text-lg">
      {wheelGamble.summary}
    </p>

    <div class="mt-8 overflow-hidden rounded-2xl border border-border bg-black">
      <div class="aspect-video">
        <iframe
          src={embedUrl}
          title={`${wheelGamble.name} gameplay`}
          class="h-full w-full"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Overview</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-text-secondary md:text-base">
        {wheelGamble.overview.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Zones</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-text-secondary md:text-base">
        {wheelGamble.zonesIntro}
      </p>
      <ul class="mt-4 grid gap-3 md:grid-cols-3">
        {
          wheelGamble.zones.map((zone) => (
            <li class="rounded-xl border border-border bg-surface-card px-4 py-3">
              <p class="text-sm font-medium text-text-primary">{zone.name}</p>
              <p class="mt-1 text-sm text-text-secondary">{zone.detail}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Architecture</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 max-w-3xl space-y-4 text-sm leading-relaxed text-text-secondary md:text-base">
        {wheelGamble.architecture.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="mt-14 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-xl font-semibold text-text-primary">Animation & UI</h2>
        <div class="mt-4 h-px w-12 bg-accent"></div>
        <p class="mt-6 text-sm leading-relaxed text-text-secondary">
          {wheelGamble.animationIntro}
        </p>
        <ul class="mt-4 space-y-3">
          {
            wheelGamble.animations.map((item) => (
              <li class="rounded-xl border border-border bg-surface-card px-4 py-3 text-sm leading-relaxed text-text-secondary">
                {item}
              </li>
            ))
          }
        </ul>
        <p class="mt-4 text-sm leading-relaxed text-text-secondary">
          {wheelGamble.ui}
        </p>
      </div>

      <div>
        <h2 class="text-xl font-semibold text-text-primary">Editor tools</h2>
        <div class="mt-4 h-px w-12 bg-accent"></div>
        <ul class="mt-6 space-y-3">
          {
            wheelGamble.tools.map((tool) => (
              <li class="rounded-xl border border-border bg-surface-card px-4 py-3">
                <p class="text-sm font-medium text-text-primary">{tool.name}</p>
                <p class="mt-1 text-sm text-text-secondary">{tool.detail}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Code quality</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-text-secondary md:text-base">
        {wheelGamble.quality}
      </p>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Technologies</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <div class="mt-6 flex flex-wrap gap-2">
        {wheelGamble.stack.map((tech) => <TechTag label={tech} />)}
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-semibold text-text-primary">Features</h2>
      <div class="mt-4 h-px w-12 bg-accent"></div>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {
          wheelGamble.features.map((feature) => (
            <li class="rounded-xl border border-border bg-surface-card px-4 py-3 text-sm leading-relaxed text-text-secondary">
              {feature}
            </li>
          ))
        }
      </ul>
    </section>

    <Footer />
  </main>
</Layout>
